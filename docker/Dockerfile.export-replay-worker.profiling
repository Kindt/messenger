FROM gradle:jdk25-noble AS builder
WORKDIR /app
COPY . .
RUN gradle --console=plain :modules:workers:export-replay:installDist --no-daemon -x test

FROM eclipse-temurin:25-jdk
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/modules/workers/export-replay/build/install/export-replay /app/export-replay
ENTRYPOINT ["/app/export-replay/bin/export-replay"]
