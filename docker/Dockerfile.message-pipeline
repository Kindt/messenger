# Воркер fan-out msg.send → msg.deliver.* (см. docs/NATS_SUBJECTS_INTEROP.md).
FROM gradle:jdk25 AS builder
WORKDIR /app
COPY . .
RUN gradle :modules:workers:message-pipeline:installDist --no-daemon -x test

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=builder /app/modules/workers/message-pipeline/build/install/message-pipeline /app/message-pipeline
ENTRYPOINT ["/app/message-pipeline/bin/message-pipeline"]
