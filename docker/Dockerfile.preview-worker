# Link preview worker: MSG_EVENT_INDEX → SSRF-safe HTTP fetch (optional hot DB).
FROM gradle:jdk25-noble AS builder
WORKDIR /app
COPY . .
RUN gradle --console=plain :modules:workers:preview:installDist --no-daemon -x test

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/modules/workers/preview/build/install/preview /app/preview
ENTRYPOINT ["/app/preview/bin/preview"]
