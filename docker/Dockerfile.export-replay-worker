# Воркер экспорта чата по NATS msg.export.replay (см. docs/NATS_SUBJECTS_INTEROP.md).
FROM gradle:jdk25 AS builder
WORKDIR /app
COPY . .
RUN gradle :modules:workers:export-replay:installDist --no-daemon -x test

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/modules/workers/export-replay/build/install/export-replay /app/export-replay
ENTRYPOINT ["/app/export-replay/bin/export-replay"]
