# Bot delivery worker: msg.event.bot → webhook POST (metadata only).
FROM gradle:jdk25-noble AS builder
WORKDIR /app
COPY . .
RUN gradle --console=plain :modules:workers:bot-delivery:installDist --no-daemon -x test

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/modules/workers/bot-delivery/build/install/bot-delivery /app/bot-delivery
ENTRYPOINT ["/app/bot-delivery/bin/bot-delivery"]
