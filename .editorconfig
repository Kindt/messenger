# https://editorconfig.org
# Java: 4 spaces (e.g. modules/core-api/.../ContactRepository.java).
# Gradle Kotlin DSL: 4 spaces (e.g. build.gradle.kts). No application .kt sources in-tree.
# YAML/GitHub Actions: 2 spaces (e.g. .github/workflows/ci.yml).
# XML (logback etc.): 2 spaces (e.g. modules/core-api/src/main/resources/logback.xml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,properties}]
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{xml,xsd}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.json]
indent_style = space
indent_size = 2
