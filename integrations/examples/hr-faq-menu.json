{
  "config_schema_version": 2,
  "welcome_text": "HR FAQ (example). Команды: /phone",
  "vars": {
    "it_phone": "1234",
    "portal_url": "https://hr.example/leave"
  },
  "slash_commands": [
    {
      "command": "/phone",
      "response_text": "ИТ поддержка: {{config.it_phone}}"
    }
  ],
  "menu": {
    "root": ["vacation", "it"],
    "buttons": [
      {
        "id": "vacation",
        "label": "Отпуск",
        "when": { "text_contains": "отпуск" },
        "response_text": "Заявление через корпоративный портал: {{config.portal_url}}",
        "url": "{{config.portal_url}}"
      },
      {
        "id": "it",
        "label": "ИТ поддержка",
        "response_text": "Создайте заявку в Service Desk или напишите @sd-bot",
        "url": "https://sd.example/new"
      }
    ]
  }
}
