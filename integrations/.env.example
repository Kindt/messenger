# Spec 014 — integrations backend configuration (copy to integrations/.env on guest)
# INTEGRATIONS_BACKEND_MODE: mock | live | auto (default auto = live when creds present)

INTEGRATIONS_BACKEND_MODE=auto
MOCK_API_BASE=http://mock-apis:8080

# Microsoft Graph (Exchange bridge)
# GRAPH_ACCESS_TOKEN=
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# WebDAV storage (storage-bridge live)
# WEBDAV_BASE_URL=https://files.example.com/dav
# WEBDAV_USER=
# WEBDAV_PASSWORD=

# 1C OData (onec-bridge live)
# ONEC_BASE_URL=http://1c-host/base
# ONEC_USER=
# ONEC_PASSWORD=
# ONEC_CATALOG_ENTITY=Catalog_Номенклатура

# On-prem OCR HTTP service
# OCR_HTTP_URL=http://ocr-service:8080

# LLM (ai-bridge) — on-prem first, cloud when org policy allows
# LLM_ON_PREM_URL=http://vllm:8000
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
