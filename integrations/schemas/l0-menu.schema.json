{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korus.local/schemas/l0-menu.schema.json",
  "title": "L0 FAQ menu config",
  "type": "object",
  "properties": {
    "welcome_text": { "type": "string" },
    "menu": {
      "type": "object",
      "required": ["root", "buttons"],
      "properties": {
        "root": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "response_text": { "type": "string" },
              "url": { "type": "string" },
              "children": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["menu"],
  "additionalProperties": false
}
