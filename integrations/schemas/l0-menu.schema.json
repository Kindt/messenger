{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korus.local/schemas/l0-menu.schema.json",
  "title": "L0 FAQ menu config (v2 L0+)",
  "type": "object",
  "properties": {
    "config_schema_version": { "type": "integer", "minimum": 1, "maximum": 2 },
    "welcome_text": { "type": "string" },
    "vars": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "slash_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "response_text"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "response_text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "menu": {
      "type": "object",
      "required": ["root", "buttons"],
      "properties": {
        "root": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "response_text": { "type": "string" },
              "url": { "type": "string" },
              "children": {
                "type": "array",
                "items": { "type": "string" }
              },
              "when": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "text_contains": { "type": "string" },
                  "text_equals": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["menu"],
  "additionalProperties": false
}
