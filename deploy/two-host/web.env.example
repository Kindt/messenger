# Скопируйте в korus-web/.env на машине 2 (веб-клиент).
# Замените плейсхолдеры на реальные LAN-IP.

KORUS_WEB_LB_PORT=9088
# Порт hot-swap (dev-overlay-up); по умолчанию совпадает с lb
#KORUS_WEB_DEV_PORT=9088

# IP машины 1 (dev-сервер)
KORUS_SERVER_HOST=192.168.1.10

WEB_CLIENT_API_UPSTREAM=http://192.168.1.10:8080
WEB_CLIENT_WS_PUBLIC_URL=ws://192.168.1.20:9088/ws
KORUS_WS_GATEWAY_HOST=192.168.1.10
KORUS_WS_GATEWAY_PORT=8082

# WEB_LAN_IP для браузера в WEB_CLIENT_WS_PUBLIC_URL — IP этой (веб) машины, например 192.168.1.20

# Web Push (scripts/generate-vapid.*); public key должен совпадать с PUSH_VAPID_PUBLIC_KEY на сервере
#WEB_CLIENT_VAPID_PUBLIC_KEY=
