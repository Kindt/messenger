# Подсказки для машины 1 (dev-сервер). Скопируйте нужные строки в docker/.env или export перед compose.
#
# Явная публикация портов на все интерфейсы — docker-compose.lan-publish.yml (скрипт server-host-up).
# KORUS_LAN_BIND=0.0.0.0   # документация; фактически задаётся в lan-publish.yml
# COMPOSE_FILE=docker/docker-compose.full-server.yml:docker/docker-compose.lan-publish.yml
#
# На сервере с MinIO можно хранить экспорт в object storage (без общего EXPORT_DIR с core-api):
# EXPORT_REPLAY_MINIO_UPLOAD=true
#
# Retention → compliance export hint + optional auto-queue (core-api):
# RETENTION_PUBLISH_EXPORT_SUGGESTED=true
# EXPORT_AUTO_QUEUE_ON_SUGGESTED=true
# EXPORT_AUTO_QUEUE_ACTOR_USER_ID=<system-user-uuid>   # optional; default chat owner
# EXPORT_AUTO_QUEUE_COOLDOWN_MINUTES=1440
#
# Полный compliance-пакет (JSON + файлы в zip):
# EXPORT_REPLAY_INCLUDE_FILE_BODIES=true
# EXPORT_REPLAY_MAX_FILE_BODIES=500
# EXPORT_REPLAY_MAX_FILE_BODY_BYTES=52428800
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=avandocmsg
# MINIO_SECRET_KEY=avandocmsg123
# MINIO_BUCKET=avandocmsg
#
# CORS_ALLOWED_ORIGINS=http://192.168.1.20:9088
#
# LAN-IP этой машины (для документации, скрипты не читают автоматически):
# KORUS_SERVER_LAN_IP=192.168.1.10
#
# Web Push на push-worker (scripts/generate-vapid.*; public = WEB_CLIENT_VAPID_PUBLIC_KEY на web):
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:notify@localhost
