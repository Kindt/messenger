# Ansible-managed server secrets (group_vars/vault.yml). Dev/CI omits vault — file not rendered.
{% if korus_db_password is defined %}
DB_PASSWORD={{ korus_db_password }}
POSTGRES_PASSWORD={{ korus_db_password }}
KC_DB_PASSWORD={{ korus_db_password }}
{% endif %}
{% if korus_minio_secret_key is defined %}
MINIO_SECRET_KEY={{ korus_minio_secret_key }}
MINIO_ROOT_PASSWORD={{ korus_minio_secret_key }}
{% endif %}
{% if korus_keycloak_admin_password is defined %}
KEYCLOAK_ADMIN_PASSWORD={{ korus_keycloak_admin_password }}
KEYCLOAK_MASTER_PASSWORD={{ korus_keycloak_admin_password }}
{% endif %}
{% if korus_jwt_secret is defined %}
JWT_SECRET={{ korus_jwt_secret }}
{% endif %}
{% if korus_avatar_token_hmac_secret is defined %}
AVATAR_TOKEN_HMAC_SECRET={{ korus_avatar_token_hmac_secret }}
{% endif %}
{% if korus_avatar_token_hmac_secret_previous is defined %}
AVATAR_TOKEN_HMAC_SECRET_PREVIOUS={{ korus_avatar_token_hmac_secret_previous }}
{% endif %}
{% if korus_api_public_base_url is defined %}
API_PUBLIC_BASE_URL={{ korus_api_public_base_url }}
{% endif %}
{% if korus_coturn_secret is defined %}
KORUS_COTURN_SECRET={{ korus_coturn_secret }}
{% endif %}
{% if korus_vapid_public_key is defined %}
PUSH_VAPID_PUBLIC_KEY={{ korus_vapid_public_key }}
{% endif %}
{% if korus_vapid_private_key is defined %}
PUSH_VAPID_PRIVATE_KEY={{ korus_vapid_private_key }}
{% endif %}
{% if korus_vapid_subject is defined %}
PUSH_VAPID_SUBJECT={{ korus_vapid_subject }}
{% endif %}
{% if korus_cors_allowed_origins is defined %}
CORS_ALLOWED_ORIGINS={{ korus_cors_allowed_origins }}
{% endif %}
{% if korus_csp_policy is defined %}
CSP_POLICY={{ korus_csp_policy | tojson }}
{% endif %}
{% if korus_keycloak_issuer is defined %}
KEYCLOAK_ISSUER={{ korus_keycloak_issuer }}
{% elif korus_tls_enabled | default(false) | bool and korus_tls_domain is defined and korus_keycloak_https | default(false) | bool %}
KEYCLOAK_ISSUER=https://{{ korus_tls_domain }}/realms/avandocmsg
{% endif %}
{% if korus_keycloak_jwks_url is defined %}
KEYCLOAK_JWKS_URL={{ korus_keycloak_jwks_url }}
{% elif korus_tls_enabled | default(false) | bool and korus_tls_domain is defined and korus_keycloak_https | default(false) | bool %}
KEYCLOAK_JWKS_URL=https://{{ korus_tls_domain }}/realms/avandocmsg/protocol/openid-connect/certs
{% endif %}
# core-api deploy mode (spec 021 Phase 7.2): embedded | war
CORE_API_DEPLOY_MODE={{ korus_core_api_deploy_mode | default('embedded') }}
{% if korus_core_api_deploy_mode | default('embedded') == 'war' %}
# WAR path: build docker/Dockerfile.core-api.war; compose profile core-api-war pending T021-100.
# CORE_API_WAR_IMAGE={{ korus_core_api_war_container_image | default('korus-messenger-core-api-war:local') }}
{% endif %}
# Product modules (spec 021) — empty = Base-only (QEMU lab must not inherit stale addon env).
KORUS_DEPLOY_PROFILE={{ korus_deploy_profile | default('standard') }}
{% if korus_lab_allow_dev_secrets | default(false) | bool %}
KORUS_LAB_ALLOW_DEV_SECRETS=true
{% endif %}
{% set _addons = korus_product_addons | default('') %}
{% if _addons is string %}
KORUS_PRODUCT_ADDONS={{ _addons }}
{% elif _addons is iterable %}
KORUS_PRODUCT_ADDONS={{ _addons | join(',') }}
{% else %}
KORUS_PRODUCT_ADDONS=
{% endif %}
{% if korus_external_stack_manifest_enabled | default(true) | bool %}
EXTERNAL_STACK_MANIFEST_DIR={{ (korus_external_stack_manifest_path | default(korus_repo_root ~ '/docker/external-stack-manifest.yaml')) | dirname }}
EXTERNAL_STACK_MANIFEST_FILE={{ (korus_external_stack_manifest_path | default(korus_repo_root ~ '/docker/external-stack-manifest.yaml')) | basename }}
EXTERNAL_STACK_MANIFEST_PATH=/config/{{ (korus_external_stack_manifest_path | default(korus_repo_root ~ '/docker/external-stack-manifest.yaml')) | basename }}
{% endif %}
