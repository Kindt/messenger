# Korus web .env for two-host / LAN / QEMU (spec 003); TLS wss + optional vault (spec 004 US1)
{% set ws_public_host = korus_browser_ws_host | default(korus_web_lan_ip) %}
{% set ws_public_port = korus_browser_ws_port | default(korus_web_port | default(9088)) %}
{% set api_upstream = korus_web_api_upstream | default('http://' ~ korus_server_lan_ip ~ ':' ~ (korus_api_port | string)) %}
{% set ws_gw_host = korus_ws_gateway_host | default(korus_server_lan_ip) %}
{% set ws_gw_port = korus_ws_gateway_port | default(korus_ws_port) %}
KORUS_WEB_LB_PORT={{ korus_web_port | default(9088) }}
KORUS_SERVER_HOST={{ korus_server_lan_ip }}
WEB_CLIENT_API_UPSTREAM={{ api_upstream }}
{% if korus_tls_enabled | default(false) | bool and korus_tls_domain is defined %}
WEB_CLIENT_WS_PUBLIC_URL=wss://{{ korus_tls_domain }}/ws
{% else %}
WEB_CLIENT_WS_PUBLIC_URL=ws://{{ ws_public_host }}:{{ ws_public_port }}/ws
{% endif %}
KORUS_WS_GATEWAY_HOST={{ ws_gw_host }}
KORUS_WS_GATEWAY_PORT={{ ws_gw_port }}
{% if korus_web_rtc_ice_servers is defined %}
WEB_CLIENT_RTC_ICE_SERVERS={{ korus_web_rtc_ice_servers }}
{% elif korus_coturn_secret is defined and korus_turn_host is defined %}
WEB_CLIENT_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:{{ korus_turn_host }}:3478?transport=udp","turn:{{ korus_turn_host }}:3478?transport=tcp"],"username":"korus","credential":"{{ korus_coturn_secret }}"}]
{% endif %}
{% if korus_vapid_public_key is defined %}
WEB_CLIENT_VAPID_PUBLIC_KEY={{ korus_vapid_public_key }}
{% endif %}
{% if korus_coturn_secret is defined %}
KORUS_COTURN_SECRET={{ korus_coturn_secret }}
{% endif %}
