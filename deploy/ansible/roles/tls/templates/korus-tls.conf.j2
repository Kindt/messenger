# Korus Messenger TLS reverse proxy (Ansible role tls)
# Web upstream: http://127.0.0.1:{{ korus_web_port | default(9088) }}
{% if korus_tls_proxy_api | default(true) | bool %}
# API upstream: http://127.0.0.1:{{ korus_api_port | default(8080) }}
{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ korus_tls_domain }};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ korus_tls_domain }};

    ssl_certificate {{ korus_tls_cert_path }};
    ssl_certificate_key {{ korus_tls_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:{{ korus_web_port | default(9088) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
    }

    location /ws {
        proxy_pass http://127.0.0.1:{{ korus_web_port | default(9088) }}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

{% if korus_tls_proxy_api | default(true) | bool %}
    location /api/ {
        proxy_pass http://127.0.0.1:{{ korus_api_port | default(8080) }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
}
