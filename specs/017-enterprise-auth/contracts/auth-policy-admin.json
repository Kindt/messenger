{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthPolicyAdmin",
  "type": "object",
  "required": ["org_id", "allow_local_password", "allow_self_registration", "providers"],
  "properties": {
    "org_id": { "type": "string", "format": "uuid" },
    "allow_local_password": { "type": "boolean" },
    "allow_self_registration": { "type": "boolean" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "alias", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["ldap", "oidc", "saml"] },
          "alias": { "type": "string" },
          "display_name": { "type": "string" },
          "priority": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "secret_ref": { "type": "string" },
          "settings": { "type": "object", "additionalProperties": { "type": "string" } },
          "status": { "type": "string" },
          "kc_component_id": { "type": "string" }
        }
      }
    },
    "last_apply_status": { "type": ["string", "null"] },
    "last_apply_error": { "type": ["string", "null"] }
  }
}
