# Скопируйте в .env и при необходимости измените.
# Два хоста в LAN: шаблон deploy/two-host/web.env.example, скрипты server-host-up / web-host-up.
# Порт публикации балансировщика (должен совпадать с хостом/портом в WEB_CLIENT_WS_PUBLIC_URL при работе через /ws на lb).
KORUS_WEB_LB_PORT=9088

# Upstream core-api для прокси внутри контейнера web-client (HTTP).
WEB_CLIENT_API_UPSTREAM=http://host.docker.internal:8080

# URL WebSocket для браузера: через lb (по умолчанию совпадает с KORUS_WEB_LB_PORT) или напрямую на ws-gateway.
WEB_CLIENT_WS_PUBLIC_URL=ws://localhost:9088/ws

# --- QEMU на Windows (web guest 192.168.76.20, Ansible qemu-web-local) ---
# Браузер на хосте: UI http://127.0.0.1:19088 , API через прокси UI → host 18080.
# WEB_CLIENT_API_UPSTREAM в госте задаётся Ansible: http://10.0.2.2:18080 (см. deploy/ansible/inventory/qemu/group_vars/all.yml).
# WS для браузера: ws://<host-lan-ip>:19088/ws (korus_qemu_host_lan_ip в inventory).
# Playwright: PLAYWRIGHT_BASE_URL=http://127.0.0.1:19088 KORUS_API_URL=http://127.0.0.1:18080

# Опционально: ICE для WebRTC (одна строка JSON — массив объектов urls/username/credential). Проброс в контейнер web-client как WEB_CLIENT_RTC_ICE_SERVERS.
#WEB_CLIENT_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Опционально: VAPID public key (URL-safe Base64) для Web Push в браузере.
# Сгенерировать пару: scripts/generate-vapid.ps1 или scripts/generate-vapid.sh
#WEB_CLIENT_VAPID_PUBLIC_KEY=
# На push-worker (full-server): PUSH_VAPID_PUBLIC_KEY, PUSH_VAPID_PRIVATE_KEY, PUSH_VAPID_SUBJECT
# Локальный TURN без ручного JSON: см. docker-compose.turn.yml и scripts/korus-web-up.ps1 -Turn (или korus-web-up.sh --turn).

# Хост и порт ws-gateway для location /ws на nginx-lb (внутри Docker-сети или host.docker.internal).
# Если ws-gateway поднят из docker-compose.dev-min.yml с профилем web — на хосте слушает порт 8082:
#   KORUS_WS_GATEWAY_PORT=8082
KORUS_WS_GATEWAY_HOST=host.docker.internal
KORUS_WS_GATEWAY_PORT=8081

# --- docker-compose.attach.yml (общая сеть с dev-min) ---
# По умолчанию совпадает с docker/docker-compose.dev-min.yml (сеть default → korus_messenger_dev_min).
#KORUS_DEV_MIN_NETWORK=korus_messenger_dev_min
