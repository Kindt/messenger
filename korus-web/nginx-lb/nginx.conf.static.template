worker_processes auto;
worker_rlimit_nofile 4096;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    include /etc/nginx/includes/mime-mjs.conf;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log combined;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64m;

    include /etc/nginx/includes/compression.conf;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream korus_core_api {
        server ${WEB_CLIENT_API_UPSTREAM_HOST}:${WEB_CLIENT_API_UPSTREAM_PORT};
    }

    upstream korus_ws_gateway {
        server ${KORUS_WS_GATEWAY_HOST}:${KORUS_WS_GATEWAY_PORT};
    }

    server {
        listen 80;
        server_name _;
        root /usr/share/nginx/html;

        location = /nginx-health {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok","component":"nginx-static"}';
        }

        location = /web-client-env.js {
            alias /var/lib/korus/web-client-env.js;
            default_type application/javascript;
            add_header Cache-Control "no-store, max-age=0" always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /health {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok","component":"web-lb"}';
        }

        location /api/ {
            proxy_pass http://korus_core_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_read_timeout 3600s;
        }

        location /ws {
            proxy_pass http://korus_ws_gateway/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
        }

        # Content-hashed build assets (Vite/ESBuild: *.abc12345.js / /assets/*).
        location ~* \.[0-9a-f]+\.(js|css|mjs|woff2?)$ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        location ~* ^/assets/.+\.[0-9a-f]+\.(js|css|mjs|woff2?)$ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        # Service worker and HTML shell — always revalidate on deploy.
        location = /sw.js {
            try_files $uri =404;
            add_header Cache-Control "no-store, max-age=0" always;
        }

        location = /ui-lazy-call.mjs {
            try_files $uri =404;
            add_header Cache-Control "no-store, max-age=0" always;
        }

        location = /index.html {
            try_files $uri =404;
            add_header Cache-Control "no-store, max-age=0" always;
        }

        location = /manifest.json {
            try_files $uri =404;
            add_header Cache-Control "no-cache, must-revalidate" always;
        }

        location ~* ^/locales/.+\.json$ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        }

        # Unversioned static assets (current dev tree: ui-*.js, fonts, images).
        location ~* \.(css|js|mjs|wasm|woff2?|png|jpg|jpeg|gif|svg|ico|map)$ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
        }

        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-store, max-age=0" always;
        }
    }
}
