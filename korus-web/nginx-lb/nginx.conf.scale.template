worker_processes auto;
worker_rlimit_nofile 4096;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log combined;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream korus_java_web {
        least_conn;
        server web-a:9080 max_fails=3 fail_timeout=30s;
        server web-b:9080 max_fails=3 fail_timeout=30s;
    }

    # Sticky WS for 2× ws-gateway (spec 006 T303). Set KORUS_WS_GATEWAY_HOST_2 when scale overlay is up.
    upstream korus_ws_gateway {
        ip_hash;
        server ${KORUS_WS_GATEWAY_HOST}:${KORUS_WS_GATEWAY_PORT};
        server ${KORUS_WS_GATEWAY_HOST_2}:${KORUS_WS_GATEWAY_PORT};
    }

    server {
        listen 80;
        server_name _;

        location / {
            proxy_pass http://korus_java_web;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_read_timeout 3600s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location /ws {
            proxy_pass http://korus_ws_gateway/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
        }
    }
}
