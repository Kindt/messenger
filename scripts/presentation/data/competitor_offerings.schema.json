{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korus.local/schemas/competitor_offerings.json",
  "title": "CompetitorOfferings",
  "type": "object",
  "required": ["competitor_offerings"],
  "properties": {
    "competitor_offerings": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "label",
          "metric",
          "value",
          "price_rub",
          "price_period",
          "deployment",
          "source",
          "source_url",
          "source_type",
          "source_accessed_at",
          "price_is_public"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "metric": {
            "type": "string",
            "enum": ["registered_users", "concurrent_users"]
          },
          "value": { "type": "integer", "minimum": 1 },
          "price_rub": { "type": "integer", "minimum": 0 },
          "price_period": { "type": "string", "enum": ["month", "year"] },
          "deployment": {
            "type": "string",
            "enum": ["on_prem", "saas", "hybrid"]
          },
          "source": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https://" },
          "source_type": {
            "type": "string",
            "enum": [
              "public_pricing",
              "public_docs",
              "public_press",
              "no_public_price"
            ]
          },
          "source_accessed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "price_is_public": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
